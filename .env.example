# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-service-role-key

# Service-role key (Project Settings -> API -> service_role, NOT the anon
# key above). Used only by billing.py to write a clinic's subscription
# status after checking with Stripe -- never exposed to the browser, since
# Streamlit runs entirely server-side. Keep this at least as secret as a
# database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing (Dashboard -> Developers -> API keys, and Product catalog
# for the price ID). Use test-mode keys until you're ready to charge for
# real.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# This app's own public URL, so Stripe Checkout/the billing portal know
# where to send customers back to after payment.
APP_BASE_URL=https://your-app.streamlit.app
